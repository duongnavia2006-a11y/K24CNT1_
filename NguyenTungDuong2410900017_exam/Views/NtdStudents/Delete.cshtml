@model NguyenTungDuong2410900017_exam.Models.NtdStudent

@{
    ViewData["Title"] = "Xác nhận xóa sinh viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa sinh viên
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Cảnh báo:</strong> Bạn có chắc chắn muốn xóa bản ghi sinh viên này không? Thao tác này không thể hoàn tác!
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted">Mã sinh viên (ID):</dt>
                        <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Họ và tên:</dt>
                        <dd class="col-sm-8 fw-semibold text-danger fs-5">@Model.NtdName</dd>

                        <dt class="col-sm-4 text-muted">Giới tính:</dt>
                        <dd class="col-sm-8">
                            @if (Model.NtdGender)
                            {
                                <span class="badge bg-primary px-3 py-2">Nam</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2">Nữ</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Ngày sinh:</dt>
                        <dd class="col-sm-8">
                            @(Model.NtdBirthDay.HasValue ? Model.NtdBirthDay.Value.ToString("dd/MM/yyyy") : "—")
                        </dd>

                        <dt class="col-sm-4 text-muted">Email:</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.NtdEmail) ? Model.NtdEmail : "—")</dd>

                        <dt class="col-sm-4 text-muted">Số điện thoại:</dt>
                        <dd class="col-sm-8">@(!string.IsNullOrEmpty(Model.NtdPhone) ? Model.NtdPhone : "—")</dd>

                        <dt class="col-sm-4 text-muted">Trạng thái:</dt>
                        <dd class="col-sm-8">
                            @if (Model.NtdActive)
                            {
                                <span class="badge bg-success px-3 py-2">Đang học</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">Tạm dừng</span>
                            }
                        </dd>
                    </dl>

                    <form asp-action="Delete" method="post" class="d-flex justify-content-between pt-3 border-top">
                        <input type="hidden" asp-for="Id" />
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            &larr; Không, quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Xác nhận xóa
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
