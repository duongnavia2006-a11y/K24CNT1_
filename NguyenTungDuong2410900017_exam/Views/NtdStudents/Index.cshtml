@model IEnumerable<NguyenTungDuong2410900017_exam.Models.NtdStudent>

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill me-2"></i>Quản lý danh sách sinh viên
            </h2>
            <p class="text-muted mb-0">Học phần: Phát triển ứng dụng với ASP.NET Core MVC (EF Core Database First)</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> + Thêm mới sinh viên
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-primary text-nowrap">
                        <tr>
                            <th class="ps-3">Mã SV</th>
                            <th>Họ và tên</th>
                            <th class="text-center">Giới tính</th>
                            <th>Ngày sinh</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center pe-3">Chức năng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Chưa có dữ liệu sinh viên.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-secondary">
                                        #@item.Id
                                    </td>
                                    <td class="fw-semibold text-dark">
                                        @item.NtdName
                                    </td>
                                    <td class="text-center">
                                        @if (item.NtdGender)
                                        {
                                            <span class="badge bg-primary px-2 py-1">Nam</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2 py-1">Nữ</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.NtdBirthDay.HasValue ? item.NtdBirthDay.Value.ToString("dd/MM/yyyy") : "—")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.NtdEmail))
                                        {
                                            <a href="mailto:@item.NtdEmail" class="text-decoration-none text-body">@item.NtdEmail</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @(!string.IsNullOrEmpty(item.NtdPhone) ? item.NtdPhone : "—")
                                    </td>
                                    <td class="text-center">
                                        @if (item.NtdActive)
                                        {
                                            <span class="badge bg-success px-2 py-1">Đang học</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2 py-1">Tạm dừng</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3 text-nowrap">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1 shadow-sm" title="Sửa">
                                            Sửa
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm text-white me-1 shadow-sm" title="Chi tiết">
                                            Chi tiết
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm shadow-sm" title="Xóa">
                                            Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white text-muted small py-3 px-3 d-flex justify-content-between align-items-center">
            <span>Tổng số: <strong>@Model.Count()</strong> sinh viên</span>
            <span>Nguyễn Tùng Dương - 2410900017</span>
        </div>
    </div>
</div>
