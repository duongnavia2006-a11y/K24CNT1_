@model NguyenTungDuong2410900017_exam.Models.NtdStudent

@{
    ViewData["Title"] = "Chỉnh sửa sinh viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin sinh viên #@Model.Id
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="NtdName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input asp-for="NtdName" class="form-control" />
                            <span asp-validation-for="NtdName" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NtdGender" class="form-label fw-semibold">Giới tính</label>
                                <select asp-for="NtdGender" class="form-select">
                                    <option value="true">Nam</option>
                                    <option value="false">Nữ</option>
                                </select>
                                <span asp-validation-for="NtdGender" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NtdBirthDay" class="form-label fw-semibold">Ngày sinh</label>
                                <input asp-for="NtdBirthDay" type="date" class="form-control" 
                                       value="@(Model.NtdBirthDay?.ToString("yyyy-MM-dd"))" />
                                <span asp-validation-for="NtdBirthDay" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="NtdEmail" class="form-label fw-semibold">Email</label>
                                <input asp-for="NtdEmail" type="email" class="form-control" />
                                <span asp-validation-for="NtdEmail" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="NtdPhone" class="form-label fw-semibold">Số điện thoại</label>
                                <input asp-for="NtdPhone" class="form-control" />
                                <span asp-validation-for="NtdPhone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NtdActive" class="form-label fw-semibold">Trạng thái học tập</label>
                            <select asp-for="NtdActive" class="form-select">
                                <option value="true">Đang học</option>
                                <option value="false">Tạm dừng</option>
                            </select>
                            <span asp-validation-for="NtdActive" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                &larr; Quay lại danh sách
                            </a>
                            <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">
                                <i class="bi bi-check2-circle me-1"></i> Cập nhật thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
