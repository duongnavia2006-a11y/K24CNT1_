@model NtdLesson08Models.Models.NtdMember

@{
    ViewData["Title"] = "Sửa thông tin thành viên";
}
<form asp-action="NtdEdit" method="post">
    <div class="card p-3">
        <div class="card-header">
            <h1>@ViewData["Title"]</h1>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="NtdMemberId" class="control-label"></label>
                        <input asp-for="NtdMemberId" class="form-control" />
                        <span asp-validation-for="NtdMemberId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NtdUserName" class="control-label"></label>
                        <input asp-for="NtdUserName" class="form-control" />
                        <span asp-validation-for="NtdUserName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NtdPassword" class="control-label"></label>
                        <input asp-for="NtdPassword" class="form-control" />
                        <span asp-validation-for="NtdPassword" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NtdFullName" class="control-label"></label>
                        <input asp-for="NtdFullName" class="form-control" />
                        <span asp-validation-for="NtdFullName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="NtdEmail" class="control-label"></label>
                        <input asp-for="NtdEmail" class="form-control" />
                        <span asp-validation-for="NtdEmail" class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="form-group">
                <input type="submit" value="Cập nhật" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>
    </div>
</form>