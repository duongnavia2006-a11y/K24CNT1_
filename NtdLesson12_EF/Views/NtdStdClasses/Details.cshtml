@model NtdLesson12_EF.Models.NtdStdClass

@{
    ViewData["Title"] = "Chi tiết lớp học";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Chi tiết lớp học: @Model.ClassName</h2>
    <hr />
    <div class="card col-md-8 shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Danh sách sinh viên trong lớp (@(Model.Students?.Count ?? 0) sinh viên)</h5>
            @if (Model.Students != null && Model.Students.Any())
            {
                <table class="table table-sm table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Mã SV</th>
                            <th>Họ và tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Students)
                        {
                            <tr>
                                <td>@s.Id</td>
                                <td>@s.StudentName</td>
                                <td>@s.StudentEmail</td>
                                <td>@s.StudentPhone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted">Chưa có sinh viên nào trong lớp này.</p>
            }
        </div>
        <div class="card-footer bg-white border-top-0">
            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Chỉnh sửa</a>
            <a class="btn btn-sm btn-secondary ms-2" asp-action="Index">Quay lại danh sách</a>
        </div>
    </div>
</div>
