@model IEnumerable<NtdLesson12_EF.Models.NtdProduct>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Danh sách sản phẩm</h2>
        <p class="text-muted">Các mặt hàng hiện có trong hệ thống</p>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border text-center p-3">
                        <div class="mb-3" style="height: 180px; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/Product/@item.Image" class="img-fluid rounded" alt="@item.Name" style="max-height: 170px; max-width: 100%; object-fit: contain;" onerror="this.src='https://placehold.co/180x180?text=Product'" />
                            }
                            else
                            {
                                <img src="https://placehold.co/180x180?text=Product" class="img-fluid rounded" alt="@item.Name" style="max-height: 170px; max-width: 100%; object-fit: contain;" />
                            }
                        </div>
                        <div class="card-body p-0 d-flex flex-column">
                            <h6 class="card-title fw-semibold text-truncate mb-2" title="@item.Name">@item.Name</h6>
                            <div class="mt-auto">
                                <span class="text-danger fw-bold fs-6">@item.Price.ToString("N0") đ</span>
                                @if (item.SalePrice > 0)
                                {
                                    <span class="text-muted text-decoration-line-through small ms-2">@item.SalePrice.ToString("N0") đ</span>
                                }
                                <div class="mt-3">
                                    <a asp-controller="NtdProducts" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary w-100">Chi tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">Chưa có sản phẩm nào. Vui lòng thêm sản phẩm từ trang quản trị!</p>
                <a asp-controller="NtdProducts" asp-action="Create" class="btn btn-sm btn-success">Thêm sản phẩm</a>
            </div>
        }
    </div>
</div>
