@model IEnumerable<NtdLesson12_EF.Models.NtdProduct>

@{
    ViewData["Title"] = "Trang chủ - NtdLesson12_EF";
    var banners = ViewBag.Banners as List<NtdLesson12_EF.Models.NtdBanner>;
}

<!-- Banner Carousel trên trang chủ theo Bài 4 slide Lab 06 -->
<div class="container-fluid px-0 mb-5">
    <div id="ntdBannerCarousel" class="carousel slide shadow" data-bs-ride="carousel">
        <div class="carousel-indicators">
            @if (banners != null && banners.Any())
            {
                for (int i = 0; i < banners.Count; i++)
                {
                    <button type="button" data-bs-target="#ntdBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)"></button>
                }
            }
            else
            {
                <button type="button" data-bs-target="#ntdBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#ntdBannerCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            }
        </div>
        <div class="carousel-inner">
            @if (banners != null && banners.Any())
            {
                for (int i = 0; i < banners.Count; i++)
                {
                    var banner = banners[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")" style="max-height: 460px; background-color: #1a237e;">
                        @if (!string.IsNullOrEmpty(banner.Image))
                        {
                            <img src="~/Banner/@banner.Image" class="d-block w-100" alt="@banner.Name" style="max-height: 460px; object-fit: cover;" onerror="this.src='https://placehold.co/1200x460/0d6efd/white?text=Banner+@(i+1)'" />
                        }
                        else
                        {
                            <div class="d-flex flex-column align-items-center justify-content-center text-white p-5" style="min-height: 400px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                                <h1 class="display-4 fw-bold">@banner.Name</h1>
                                <p class="lead">@banner.Description</p>
                            </div>
                        }
                        <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-3">
                            <h4 class="fw-bold">@banner.Name</h4>
                            <p class="mb-0">@banner.Description</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Slide mặc định theo phong cách slide bài giảng -->
                <div class="carousel-item active" style="min-height: 380px; background: linear-gradient(135deg, #0d47a1 0%, #1976d2 100%);">
                    <div class="container h-100 d-flex flex-column justify-content-center text-center text-white py-5">
                        <h1 class="display-4 fw-bold mb-3">NtdLesson12 - Entity Framework Core</h1>
                        <p class="lead fs-4 mb-4">Thực hành Code-First, CRUD và Upload ảnh với ASP.NET Core & SQL Server</p>
                        <div>
                            <a class="btn btn-warning btn-lg fw-bold px-4 me-3" asp-action="Product">Xem sản phẩm</a>
                            <a class="btn btn-outline-light btn-lg px-4" asp-controller="NtdCategories" asp-action="Index">Quản lý danh mục</a>
                        </div>
                    </div>
                </div>
                <div class="carousel-item" style="min-height: 380px; background: linear-gradient(135deg, #263238 0%, #37474f 100%);">
                    <div class="container h-100 d-flex flex-column justify-content-center text-center text-white py-5">
                        <h1 class="display-4 fw-bold mb-3">Cơ sở dữ liệu NETCORE</h1>
                        <p class="lead fs-4 mb-4">Kết nối SQL Server Server=DUONG;Database=NETCORE</p>
                        <div>
                            <a class="btn btn-success btn-lg fw-bold px-4" asp-controller="NtdProducts" asp-action="Create">Thêm sản phẩm mới</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#ntdBannerCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-label="Previous"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#ntdBannerCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-label="Next"></span>
        </button>
    </div>
</div>

<!-- Danh sách sản phẩm nổi bật -->
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="fw-bold text-primary mb-0">Sản phẩm nổi bật</h3>
        <a asp-action="Product" class="btn btn-outline-primary btn-sm">Xem tất cả sản phẩm &raquo;</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 product-card">
                        <div class="text-center p-3">
                            @if (!string.IsNullOrEmpty(item.Image))
                            {
                                <img src="~/Product/@item.Image" class="img-fluid rounded" alt="@item.Name" style="height: 180px; width: 100%; object-fit: contain;" onerror="this.src='https://placehold.co/200x180?text=Sản+phẩm'" />
                            }
                            else
                            {
                                <img src="https://placehold.co/200x180?text=Sản+phẩm" class="img-fluid rounded" alt="@item.Name" style="height: 180px; width: 100%; object-fit: contain;" />
                            }
                        </div>
                        <div class="card-body d-flex flex-column text-center">
                            <span class="badge bg-secondary mb-2 mx-auto">@(item.Category?.Name ?? "Sản phẩm")</span>
                            <h6 class="card-title fw-bold text-truncate" title="@item.Name">@item.Name</h6>
                            <div class="mt-auto">
                                <p class="card-text text-danger fw-bold fs-5 mb-2">@item.Price.ToString("N0") đ</p>
                                <a asp-controller="NtdProducts" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm w-100">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted">Chưa có sản phẩm nào trong hệ thống.</p>
                <a asp-controller="NtdProducts" asp-action="Create" class="btn btn-primary btn-sm">Thêm sản phẩm ngay</a>
            </div>
        }
    </div>
</div>
