@model IEnumerable<NtdLesson12_EF.Models.NtdMark>

@{
    ViewData["Title"] = "Quản lý Điểm số";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Bảng Điểm Sinh Viên (Marks)</h2>
        <a class="btn btn-sm btn-success" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Nhập điểm mới
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Sinh viên</th>
                <th>Môn học</th>
                <th class="text-center" style="width: 120px;">@Html.DisplayNameFor(model => model.Score)</th>
                <th class="text-center" style="width: 120px;">Đánh giá</th>
                <th class="text-center" style="width: 180px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@(item.Student?.StudentName ?? $"SV #{item.StudentId}")</td>
                        <td>@(item.Subject?.SubjectName ?? $"Môn #{item.SubjectId}")</td>
                        <td class="text-center fw-bold fs-6 @(item.Score >= 5 ? "text-success" : "text-danger")">
                            @item.Score.ToString("0.0")
                        </td>
                        <td class="text-center">
                            @if (item.Score >= 8)
                            {
                                <span class="badge bg-success">Giỏi</span>
                            }
                            else if (item.Score >= 6.5)
                            {
                                <span class="badge bg-primary">Khá</span>
                            }
                            else if (item.Score >= 5.0)
                            {
                                <span class="badge bg-warning text-dark">Trung bình</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Yếu</span>
                            }
                        </td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Sửa điểm</a> |
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-subjectId="@item.SubjectId" asp-route-studentId="@item.StudentId">Xóa</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu điểm nào. Bấm "Nhập điểm mới" để thêm!</td>
                </tr>
            }
        </tbody>
    </table>
</div>
