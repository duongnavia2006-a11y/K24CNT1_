@model NtdLesson12_EF.Models.NtdMark

@{
    ViewData["Title"] = "Nhập điểm môn học";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Nhập điểm môn học</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="StudentId" class="form-label fw-semibold">Sinh viên</label>
                    <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                        <option value="">-- Chọn sinh viên --</option>
                    </select>
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SubjectId" class="form-label fw-semibold">Môn học</label>
                    <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId">
                        <option value="">-- Chọn môn học --</option>
                    </select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Score" class="form-label fw-semibold">Điểm số (Thang điểm 10)</label>
                    <input asp-for="Score" type="number" step="0.1" min="0" max="10" class="form-control" placeholder="Ví dụ: 8.5" />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Lưu điểm" class="btn btn-sm btn-success px-3" />
                    <a class="btn btn-sm btn-danger ms-2 px-3" asp-action="Index">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
