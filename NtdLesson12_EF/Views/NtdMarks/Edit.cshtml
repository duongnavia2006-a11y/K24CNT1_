@model NtdLesson12_EF.Models.NtdMark

@{
    ViewData["Title"] = "Chỉnh sửa điểm số";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Chỉnh sửa điểm số</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="SubjectId" />
                <input type="hidden" asp-for="StudentId" />

                <div class="card p-3 mb-3 bg-light">
                    <div><strong>Sinh viên:</strong> @(Model.Student?.StudentName ?? $"SV #{Model.StudentId}")</div>
                    <div><strong>Môn học:</strong> @(Model.Subject?.SubjectName ?? $"Môn #{Model.SubjectId}")</div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Score" class="form-label fw-semibold">Điểm số mới</label>
                    <input asp-for="Score" type="number" step="0.1" min="0" max="10" class="form-control" />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Cập nhật" class="btn btn-sm btn-success px-3" />
                    <a class="btn btn-sm btn-danger ms-2 px-3" asp-action="Index">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
