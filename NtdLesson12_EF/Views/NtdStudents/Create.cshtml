@model NtdLesson12_EF.Models.NtdStudent

@{
    ViewData["Title"] = "Thêm mới sinh viên";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Thêm mới sinh viên</h2>
    <hr />
    <div class="row">
        <div class="col-md-7">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="StudentName" class="form-label fw-semibold"></label>
                    <input asp-for="StudentName" class="form-control" placeholder="Nhập họ và tên..." />
                    <span asp-validation-for="StudentName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ClassId" class="form-label fw-semibold"></label>
                    <select asp-for="ClassId" class="form-select" asp-items="ViewBag.ClassId">
                        <option value="">-- Chọn lớp học --</option>
                    </select>
                    <span asp-validation-for="ClassId" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StudentEmail" class="form-label fw-semibold"></label>
                    <input asp-for="StudentEmail" type="email" class="form-control" placeholder="example@domain.com" />
                    <span asp-validation-for="StudentEmail" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StudentPhone" class="form-label fw-semibold"></label>
                    <input asp-for="StudentPhone" class="form-control" placeholder="0987654321" />
                    <span asp-validation-for="StudentPhone" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StudentAddress" class="form-label fw-semibold"></label>
                    <input asp-for="StudentAddress" class="form-control" placeholder="Địa chỉ thường trú..." />
                    <span asp-validation-for="StudentAddress" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StudentAvatar" class="form-label fw-semibold"></label>
                    <input asp-for="StudentAvatar" class="form-control" placeholder="avatar.jpg hoặc đường dẫn ảnh..." />
                    <span asp-validation-for="StudentAvatar" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="StudentBirthday" class="form-label fw-semibold"></label>
                    <input asp-for="StudentBirthday" type="date" class="form-control" />
                    <span asp-validation-for="StudentBirthday" class="text-danger"></span>
                </div>

                <div class="form-group mt-4">
                    <input type="submit" value="Tạo mới" class="btn btn-sm btn-success px-3" />
                    <a class="btn btn-sm btn-danger ms-2 px-3" asp-action="Index">Quay lại danh sách</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
