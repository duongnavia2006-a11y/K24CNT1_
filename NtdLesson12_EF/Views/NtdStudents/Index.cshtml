@model IEnumerable<NtdLesson12_EF.Models.NtdStudent>

@{
    ViewData["Title"] = "Quản lý Sinh viên";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">Danh sách Sinh viên (Student)</h2>
        <a class="btn btn-sm btn-success" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Thêm mới sinh viên
        </a>
    </div>

    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 70px;">Mã SV</th>
                <th>@Html.DisplayNameFor(model => model.StudentName)</th>
                <th>@Html.DisplayNameFor(model => model.StdClass)</th>
                <th>@Html.DisplayNameFor(model => model.StudentEmail)</th>
                <th>@Html.DisplayNameFor(model => model.StudentPhone)</th>
                <th>@Html.DisplayNameFor(model => model.StudentBirthday)</th>
                <th class="text-center" style="width: 220px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td class="fw-semibold">@item.StudentName</td>
                        <td>
                            <span class="badge bg-info text-dark">@(item.StdClass?.ClassName ?? "Chưa có lớp")</span>
                        </td>
                        <td>@item.StudentEmail</td>
                        <td>@item.StudentPhone</td>
                        <td>@item.StudentBirthday.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a class="btn btn-sm btn-success" asp-action="Details" asp-route-id="@item.Id">Details</a> |
                            <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">Chưa có sinh viên nào. Bấm "Thêm mới sinh viên" để tạo!</td>
                </tr>
            }
        </tbody>
    </table>
</div>
