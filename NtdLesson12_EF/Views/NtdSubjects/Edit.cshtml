@model NtdLesson12_EF.Models.NtdSubject

@{
    ViewData["Title"] = "Chỉnh sửa môn học";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Chỉnh sửa môn học</h2>
    <hr />
    <div class="row">
        <div class="col-md-5">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group mb-3">
                    <label asp-for="SubjectName" class="form-label fw-semibold"></label>
                    <input asp-for="SubjectName" class="form-control" />
                    <span asp-validation-for="SubjectName" class="text-danger"></span>
                </div>
                <div class="form-group mt-4">
                    <input type="submit" value="Cập nhật" class="btn btn-sm btn-success px-3" />
                    <a class="btn btn-sm btn-danger ms-2 px-3" asp-action="Index">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
