@model NtdLesson12_EF.Models.NtdCategory

@{
    ViewData["Title"] = "Thêm mới danh mục";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Thêm mới danh mục</h2>
    <hr />
    <div class="row">
        <div class="col-md-6 col-lg-5">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên danh mục..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Status" class="form-label fw-semibold"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="1">1 - Hoạt động</option>
                        <option value="0">0 - Tạm ẩn</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
                <div class="form-group mt-4">
                    <input type="submit" value="Create" class="btn btn-sm btn-success" />
                    <a class="btn btn-sm btn-danger ms-2" asp-action="Index">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
