@model NtdLesson12_EF.Models.NtdBanner

@{
    ViewData["Title"] = "Xóa Banner";
}

<div class="container mt-4">
    <h2 class="text-danger fw-bold">Xác nhận xóa Banner</h2>
    <div class="alert alert-warning col-md-6" role="alert">
        Bạn có chắc chắn muốn xóa banner này không?
    </div>
    <div class="card col-md-6 shadow-sm border-danger">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4 fw-bold">Tên banner</dt>
                <dd class="col-sm-8 text-primary fw-semibold">@Model.Name</dd>

                <dt class="col-sm-4 fw-bold">Mô tả</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4 fw-bold">Hình ảnh</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="~/Banner/@Model.Image" alt="@Model.Name" class="rounded" style="width: 140px; height: 70px; object-fit: cover;" onerror="this.src='https://placehold.co/140x70?text=Banner'" />
                    }
                </dd>
            </dl>
        </div>
        <div class="card-footer bg-white border-top-0">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Xóa" class="btn btn-sm btn-danger px-3" />
                <a class="btn btn-sm btn-secondary ms-2 px-3" asp-action="Index">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>
