@{
    ViewData["Title"] = "Trang chủ - Báo cáo thực hành Session 07";
}

@section S1 {
    <div class="alert alert-info py-2 mb-3">
        <strong>[Minh họa Slide 6]:</strong> Nội dung này được định nghĩa tại View con và render tại vị trí <code>@@RenderSection("S1")</code> của Layout!
    </div>
}

<div class="p-4 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-2">
        <h1 class="display-5 fw-bold text-primary">NtdLesson13 - Session 07: Layout & Area</h1>
        <p class="col-md-10 fs-5 text-muted">
            Dự án bài tập ASP.NET Core MVC triển khai đúng 100% nội dung Slide bài giảng Session 07 (Tìm hiểu về Layout, Custom Layout, CSS, JS Active Link, Area Admins).
        </p>
        <hr />
        <div class="row g-2">
            <div class="col-md-6">
                <strong>Họ và tên sinh viên:</strong> Nguyễn Tùng Dương<br />
                <strong>Chữ viết tắt (Hvt):</strong> <span class="badge bg-success">Ntd</span>
            </div>
            <div class="col-md-6">
                <strong>Mã bài tập:</strong> <code>NtdLesson13</code><br />
                <strong>Phiên bản .NET:</strong> .NET 10.0
            </div>
        </div>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-2 g-4 mb-4">
    <div class="col">
        <div class="card h-100 border-primary shadow-sm">
            <div class="card-header bg-primary text-white fw-bold">
                🎯 1. Custom Layout (_LayoutHome.cshtml) - Slide 7 đến 21
            </div>
            <div class="card-body">
                <p class="card-text">
                    Đã triển khai hoàn chỉnh layout khách hàng với thanh điều hướng CSS <code>#navbar</code>, tệp <code>LayoutHome.css</code>, script <code>LayoutHome.js</code> tự động gắn class <code>.active</code> khi bấm vào link.
                </p>
                <div class="list-group">
                    <a href="/Products/Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>📦 Danh sách sản phẩm (Index)</span>
                        <span class="badge bg-primary rounded-pill">Slide 12, 18, 21</span>
                    </a>
                    <a href="/Products/Search" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>🔍 Tìm kiếm sản phẩm (Search)</span>
                        <span class="badge bg-secondary rounded-pill">Slide 12</span>
                    </a>
                    <a href="/Products/Hots" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>🔥 Sản phẩm bán chạy (Hots)</span>
                        <span class="badge bg-danger rounded-pill">Slide 12, 13</span>
                    </a>
                    <a href="/Product/About" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>ℹ️ Giới thiệu sản phẩm (About)</span>
                        <span class="badge bg-info rounded-pill">Slide 12</span>
                    </a>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <a href="/Products/Index" class="btn btn-primary w-100">Truy cập Trang Sản phẩm</a>
            </div>
        </div>
    </div>

    <div class="col">
        <div class="card h-100 border-success shadow-sm">
            <div class="card-header bg-success text-white fw-bold">
                🏢 2. Cấu trúc Area Admins - Slide 22 & 23
            </div>
            <div class="card-body">
                <p class="card-text">
                    Đã tạo Area <code>Admins</code> với cấu trúc phân cấp MVC đầy đủ (Controllers, Models, Views, Data) cùng tệp Layout quản trị riêng biệt <code>_LayoutAdmin.cshtml</code>.
                </p>
                <ul class="list-group list-group-flush mb-3">
                    <li class="list-group-item">📁 <code>Areas/Admins/Controllers/NtdHomeController.cs</code></li>
                    <li class="list-group-item">📁 <code>Areas/Admins/Views/Shared/_LayoutAdmin.cshtml</code></li>
                    <li class="list-group-item">📁 <code>Areas/Admins/Views/Home/Index.cshtml</code></li>
                    <li class="list-group-item">📁 <code>Areas/Admins/Models/NtdAdminUser.cs</code></li>
                </ul>
            </div>
            <div class="card-footer bg-transparent">
                <a href="/Admins" class="btn btn-success w-100">Truy cập Trang Quản trị (Area Admins)</a>
            </div>
        </div>
    </div>
</div>

@section S2 {
    <script>
        console.log("[Minh họa Slide 6]: Mã script từ View con được đưa vào RenderSection('S2') thành công!");
