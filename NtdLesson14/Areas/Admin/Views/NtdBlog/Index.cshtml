@model IEnumerable<NtdBlog>
@{ ViewData["Title"] = "Bài viết"; }
<section class="ntd-panel ntd-data-panel"><div class="ntd-data-toolbar"><h2>Danh sách bài viết</h2><a class="ntd-admin-button" asp-action="Create">+ Thêm bài viết</a></div><div class="ntd-table-wrap"><table class="ntd-admin-table"><thead><tr><th>Mã</th><th>Tên</th><th>Trạng thái</th><th>Ngày tạo</th><th>Hình ảnh</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var ntdBlog in Model)
{
    <tr><td>@ntdBlog.NtdId</td><td>@ntdBlog.NtdName</td><td><span class="ntd-status @(ntdBlog.NtdStatus == 1 ? "" : "ntd-status-off")">@(ntdBlog.NtdStatus == 1 ? "Đang hiện" : "Đã ẩn")</span></td><td>@ntdBlog.NtdCreatedDate.ToString("yyyy-MM-dd")</td><td>@ntdBlog.NtdImage</td><td>@ntdBlog.NtdDescription</td><td><div class="ntd-actions"><a class="ntd-admin-button ntd-admin-button-warning" asp-action="Edit" asp-route-id="@ntdBlog.NtdId">Sửa</a><a class="ntd-admin-button ntd-admin-button-danger" asp-action="Delete" asp-route-id="@ntdBlog.NtdId">Xóa</a></div></td></tr>
}
</tbody></table></div></section>
