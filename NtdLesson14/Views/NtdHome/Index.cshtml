@{
    ViewData["Title"] = "Trang chủ";
}

<section class="ntd-hero">
    <div class="ntd-hero-content">
        <p class="ntd-hero-kicker">Đồng hành cùng bạn mỗi ngày</p>
        <h1>Giải pháp phù hợp cho doanh nghiệp</h1>
        <p>Chất lượng tạo nên giá trị, uy tín xây dựng niềm tin</p>
        <a class="ntd-button" href="#introblocks">Khám phá ngay</a>
    </div>
</section>

<div class="ntd-content">
    <section id="introblocks">
        <header class="ntd-section-title">
            <h2>Giải pháp dành cho bạn</h2>
            <p>Chúng tôi luôn sẵn sàng đáp ứng nhu cầu của khách hàng</p>
        </header>
        <div class="ntd-intro-grid">
            <article class="ntd-intro-card"><span class="ntd-round-icon" aria-hidden="true">✺</span><h3>Sản phẩm chất lượng</h3><p>Sản phẩm được lựa chọn kỹ lưỡng, đáp ứng nhu cầu sử dụng hằng ngày.</p><a class="ntd-button" href="#overview">Tìm hiểu thêm</a></article>
            <article class="ntd-intro-card"><span class="ntd-round-icon" aria-hidden="true">◇</span><h3>Dịch vụ tận tâm</h3><p>Đội ngũ hỗ trợ chu đáo, luôn lắng nghe và đồng hành cùng khách hàng.</p><a class="ntd-button" href="#overview">Tìm hiểu thêm</a></article>
            <article class="ntd-intro-card"><span class="ntd-round-icon" aria-hidden="true">◉</span><h3>Uy tín hàng đầu</h3><p>Không ngừng cải thiện để mang đến trải nghiệm tốt và đáng tin cậy.</p><a class="ntd-button" href="#overview">Tìm hiểu thêm</a></article>
        </div>
    </section>

    <section id="overview" class="ntd-overview">
        <header class="ntd-section-title"><h2>Sản phẩm nổi bật</h2><p>Một số sản phẩm và nội dung mới nhất của chúng tôi</p></header>
        <div class="ntd-overview-grid">
            <article class="ntd-overview-card"><div class="ntd-overview-image" aria-hidden="true">01</div><div class="ntd-overview-copy"><h3>Đồ gia dụng</h3><p>Sản phẩm tiện ích, giúp cuộc sống gia đình thêm thuận tiện.</p></div></article>
            <article class="ntd-overview-card"><div class="ntd-overview-image" aria-hidden="true">02</div><div class="ntd-overview-copy"><h3>Thiết bị công nghệ</h3><p>Thiết bị và phụ kiện đáp ứng nhu cầu làm việc, giải trí.</p></div></article>
            <article class="ntd-overview-card"><div class="ntd-overview-image" aria-hidden="true">03</div><div class="ntd-overview-copy"><h3>Bình giữ nhiệt</h3><p>Thiết kế gọn nhẹ, tiện lợi khi mang theo mỗi ngày.</p></div></article>
            <article class="ntd-overview-card"><div class="ntd-overview-image" aria-hidden="true">04</div><div class="ntd-overview-copy"><h3>Ưu đãi mới</h3><p>Cập nhật các chương trình ưu đãi dành cho khách hàng.</p></div></article>
            <article class="ntd-overview-card"><div class="ntd-overview-image" aria-hidden="true">05</div><div class="ntd-overview-copy"><h3>Tin tức cửa hàng</h3><p>Theo dõi thông tin và các bài viết mới nhất từ cửa hàng.</p></div></article>
            <article class="ntd-overview-card"><div class="ntd-overview-image" aria-hidden="true">06</div><div class="ntd-overview-copy"><h3>Hỗ trợ khách hàng</h3><p>Liên hệ với chúng tôi để được tư vấn và hỗ trợ nhanh chóng.</p></div></article>
        </div>
        <a class="ntd-admin-link" href="/Admin">Mở trang quản trị</a>
    </section>
</div>
